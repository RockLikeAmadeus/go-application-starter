# Copy to .env and adjust. All values are optional.
STARTER_STORAGE=jsonfile     # jsonfile | memory | sqlite | postgres
STARTER_DATA_DIR=./data
PORT=8080
STARTER_LOG_FORMAT=text      # text | json
# STARTER_SERVER_URL=http://localhost:8080   # CLI/TUI remote mode
# STARTER_CONFIG_FILE=./config.toml          # a settings file for the server to read
# STARTER_PLANS_FILE=./plans.jsonc           # replaces the built-in plans
# STARTER_DATABASE_URL=postgres://user:password@localhost:5432/starter   # postgres storage; keep the real one secret

# Sign-in (the hosted edition). It needs memory, sqlite, or postgres storage.
# STARTER_SIGN_IN=oidc                       # off | oidc | dev (dev needs a devsignin build)
# The four below are required when STARTER_SIGN_IN is oidc.
# STARTER_PUBLIC_URL=https://app.example.com # register <this>/auth/oidc/callback with the provider
# STARTER_OIDC_ISSUER=https://example.eu.auth0.com/
# STARTER_OIDC_CLIENT_ID=your-client-id
# STARTER_OIDC_CLIENT_SECRET=your-client-secret   # keep the real one secret, never commit it