// The product's plans: what each one allows a workspace. See SPEC.md, "Plans,
// features and limits". Lines starting with // are comments.
//
// A limit is named after what it counts, in the plural ("items"), and says
// how many a workspace may have ("max") and what happens when it's over
// ("whenOver"): "block-new" refuses new ones, and "read-only" also refuses
// changes while over. A plan without a limit has no limit on that thing.
//
// A feature is something a plan turns on or off. "features" lists every one
// by its key ("item-export"), which code and the API use, so keep it once
// chosen. Its "name" is what people read ("Item export"), and "whenOff" says
// how front ends show it on a plan without it: "show-locked" shows it
// disabled, with a hint naming the plans that have it, and "hide" leaves it
// out. Each plan's "features" lists the keys it turns on; any other feature
// is off. See docs/features.md.
{
	// The plan a new workspace starts on, one of the plans below.
	"newWorkspacePlan": "free",
	"features": {
		// sample:start
		"item-export": {"name": "Item export", "whenOff": "show-locked"}
		// sample:end
	},
	"plans": {
		// The local edition's plan, chosen when the app is built.
		"local": {
			"limits": {},
			"features": [
				// sample:start
				"item-export"
				// sample:end
			]
		},
		// Examples of the hosted edition's plans. A new account's workspace starts
		// on newWorkspacePlan, and an admin can move it to another.
		"free": {
			"limits": {
				// sample:start
				"items": {"max": 3, "whenOver": "block-new"}
				// sample:end
			},
			"features": []
		},
		"pro": {
			"limits": {},
			"features": [
				// sample:start
				"item-export"
				// sample:end
			]
		}
	}
}
