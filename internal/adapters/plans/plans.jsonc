// The product's plans: what each one allows a workspace. See SPEC.md, "Plans
// and limits". Lines starting with // are comments.
//
// A limit is named after what it counts, in the plural ("items"), and says
// how many a workspace may have ("max") and what happens when it's over
// ("whenOver"): "block-new" refuses new ones, and "read-only" also refuses
// changes while over. A plan without a limit has no limit on that thing.
{
	"features": {
		// sample:start
		"item-export": {"name": "Item export", "whenOff": "show-locked"}
		// sample:end
	},
	"plans": {
		// The local edition's plan, chosen when the app is built.
		"local": {
			"limits": {},
			"features": [
				// sample:start
				"item-export"
				// sample:end
			]
		},
		// Examples of hosted plans, until sign-in puts workspaces on them.
		"free": {
			"limits": {
				// sample:start
				"items": {"max": 3, "whenOver": "block-new"}
				// sample:end
			},
			"features": []
		},
		"pro": {
			"limits": {},
			"features": [
				// sample:start
				"item-export"
				// sample:end
			]
		}
	}
}
